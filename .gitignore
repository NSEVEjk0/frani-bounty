# Dependencies
node_modules/

# Wallet & runtime secrets — NEVER commit. Holds the BIP39 mnemonic, device id,
# and the state ledger (escrow balances, bounty records).
wallet-data/

# Local environment overrides
.env
.env.local
.env.*.local

# Logs
*.log

# Ad-hoc test / scratch clients
test-*.mjs

# OS cruft
.DS_Store

# The offline suites below are part of the deliverable: no network, no wallet,
# no funds, no secrets. Every LIVE test stays ignored by the rule above — they
# embed an oracle API key and read a mnemonic, so they must never be published.
!test-balance-outage-unit.mjs
!test-dedup-unit.mjs
!test-retry-unit.mjs
!test-silent-close-unit.mjs

# Local operator probes — read a mnemonic; never published.
probe-*.mjs
