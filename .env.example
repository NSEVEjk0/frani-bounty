# frani-bounty — example environment configuration
# ─────────────────────────────────────────────────────────────
# Owner / Creator: Itachi
# Made by CRYPTFRANI
#
# Copy to `.env` and edit. EVERY value has a safe, conservative default in
# src/config.js — you only need to set what you want to change. The board is a
# CUSTODIAL ESCROW, so it ships timid on purpose: modest reward bounds, a global
# custody cap, generous confirmation windows, and outflow behind a kill-switch.
# Loosen on purpose, never by accident.

# ── Identity / branding ──────────────────────────────────────────────────────
# The nametag the board registers and answers to. (AGENT_NAME is an alias; if
# both are set, AGENT_NAME wins.)
AGENT_NAME=frani-bounty

# ── Owner admin (protected DM surface) ───────────────────────────────────────
# The on-network chain pubkey allowed to issue owner commands over DM
# (pause/resume, resolve, withdraw, blacklist, params). EMPTY = admin surface
# fully disabled (safe default). Set this to YOUR controlling identity's pubkey
# to enable it. Owner notices (unconfirmed sends, escalations) also go here.
# OWNER_PUBKEY=

# ── Storage ──────────────────────────────────────────────────────────────────
# Where the wallet + state ledger live. Contains the BIP39 mnemonic — back it up
# offline, never commit it. (wallet-data/ is git-ignored.)
WALLET_DIR=./wallet-data
WALLET_FILE=wallet.json
# If set, the wallet store is encrypted at rest and the mnemonic is NOT written
# to disk in plaintext (you must supply it another way to recover). Leave unset
# for a self-managing single-file wallet.
# WALLET_PASSWORD=

# ── Network (testnet2) ───────────────────────────────────────────────────────
UNICITY_NETWORK=testnet2
WALLET_API_URL=https://wallet-api.unicity.network
COIN_SYMBOL=UCT
# Public testnet aggregator oracle key (safe to leave as-is for testnet2).
# ORACLE_API_KEY=sk_ddc3cfcc001e4a28ac3fad7407f99590

# ── Protocol fee ─────────────────────────────────────────────────────────────
# Basis points (100 = 1%). Taken out of the reward ONLY on a successful release
# (worker receives reward − fee). Refunds/cancellations/expiries are ALWAYS full.
PROTOCOL_FEE_BPS=200

# ── Bounty & escrow policy ───────────────────────────────────────────────────
# Reward bounds for a single bounty (whole UCT).
MIN_REWARD_UCT=0.1
MAX_REWARD_UCT=50
# Hard ceiling on total live escrow across ALL bounties combined.
MAX_TOTAL_ESCROW_UCT=500
# Per-account anti-abuse caps.
MAX_OPEN_BOUNTIES_PER_POSTER=10
MAX_ACTIVE_CLAIMS_PER_CLAIMER=5
MAX_PROOF_ATTEMPTS=3
# Lifecycle windows. Every auto-resolution is preceded by a reminder.
FUND_WINDOW_HOURS=24     # DRAFT → funded, else auto-expire (refund any partial)
CLAIM_WINDOW_HOURS=72    # CLAIMED → proof, else the claim lapses & reopens
CONFIRM_WINDOW_HOURS=120 # SUBMITTED → poster acts, else AUTO-RELEASE to worker
OPEN_EXPIRY_DAYS=30      # OPEN & unclaimed this long → expire & refund poster

# ── Economic safety rails ────────────────────────────────────────────────────
# Observe-only kill-switch: log intended actions, move nothing. Great for a
# first dry boot against the live network.
DRY_RUN=false
# Master outflow switch. false = still accept escrow & run the state machine, but
# pay NOTHING out (releases & refunds are held). An instant freeze without a
# redeploy. The owner `pause`/`resume` DM commands flip this at runtime too.
RELEASE_ENABLED=true
# On a confirm-timeout (proof in, poster silent past the window), auto-release to
# the worker who did the work. false = escalate to the owner instead.
AUTO_RELEASE_ON_TIMEOUT=true
# An escrow board earns fees, it doesn't fund itself — self-mint is OFF. Kept
# only as an optional convenience for local demos/testing.
SELF_MINT_ENABLED=false
SELF_MINT_AMOUNT=0
# Optional operational floor of the board's OWN (non-escrow) funds never spent.
# 0 = the only protected balance is live escrow.
MIN_BALANCE_FLOOR_UCT=0
# Politeness / anti-spam (relay protection; NOT money controls).
MAX_DMS_PER_HOUR=40
MAX_ACTIONS_PER_HOUR=80
# Global cap on the NUMBER of outbound payouts per hour (rate, not amount).
MAX_RELEASES_PER_HOUR=30

# ── Housekeeping cadences ────────────────────────────────────────────────────
SWEEP_MS=900000       # sweep bounties (expiries/timeouts/reminders) every 15m
RECEIVE_POLL_MS=45000 # incoming-transfer/DM safety-net receive() poll

# ── Public advert ────────────────────────────────────────────────────────────
SERVICE_INTENT_ENABLED=true
INTENT_EXPIRES_DAYS=7
# Optional public status heartbeat each sweep (how many bounties are open, total
# reward up for grabs). Off by default.
BROADCAST_ENABLED=false
BROADCAST_TAGS=bounty,escrow,unicity
# SERVICE_DESCRIPTION=  # override the advertised description if you like

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info
